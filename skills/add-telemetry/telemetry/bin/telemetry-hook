#!/usr/bin/env bash
# telemetry-hook — opt-in Claude Code Stop hook for skill-telemetry.
#
# Why this exists: Claude (the model) often skips the telemetry-log call
# in a skill's SKILL.md — especially for proactive skills that auto-invoke
# without an explicit /skill command. Empirically this means the
# SKILL.md-based telemetry is unreliable. A Stop hook fires deterministically
# at the runtime layer regardless of whether Claude read the telemetry block.
#
# Privacy model:
#   - This hook is OPT-IN. It is NOT installed by default. The user
#     must explicitly run `skill-telemetry install-hook --skill <name>`.
#   - The hook is FILTERED. It only records events when the named skill
#     was actually used in that session — it ignores everything else.
#     If you install a hook for skill 'tdoc' and run 'office-hours' all
#     day, the tdoc hook records nothing.
#   - The hook only reads:
#       - which Skill tool calls happened (skill name only)
#       - the outcome heuristic (success/error/abandoned via tail -5)
#       - session_id, working directory basename, duration
#     It does NOT read your prompts, Claude's replies, file contents,
#     or any other transcript content.
#   - All collected data lives in plaintext at ~/.<skill>/telemetry/ so
#     you can read, audit, or delete it any time.
#
# Required env (set in settings.json hook entry):
#   SKILL_TELEMETRY_HOOK_SKILL   — the skill name to filter by (e.g. "tdoc")
#   SKILL_TELEMETRY_HOOK_BIN     — path to telemetry-log binary
#
# Optional env:
#   SKILL_TELEMETRY=off          — master kill-switch, overrides everything
#   SKILL_TELEMETRY_DIR          — override state dir (default: ~/.<skill>)

set -uo pipefail

# Master kill-switch — respects the same env var as telemetry-log
[ "${SKILL_TELEMETRY:-on}" = "off" ] && exit 0

# Required env
TARGET_SKILL="${SKILL_TELEMETRY_HOOK_SKILL:-}"
TEL_BIN="${SKILL_TELEMETRY_HOOK_BIN:-}"
[ -z "$TARGET_SKILL" ] && exit 0
# F4-style precedence-safe check (don't trust `A && : || exit` — same
# trap that bit us in F11). If the bin isn't executable, exit silently.
if [ ! -x "$TEL_BIN" ]; then exit 0; fi

# Read the Stop hook payload from stdin
PAYLOAD="$(cat 2>/dev/null || echo '{}')"

jqget() { echo "$PAYLOAD" | jq -r "$1 // empty" 2>/dev/null || true; }

SESSION_ID="$(jqget '.session_id')"
TRANSCRIPT="$(jqget '.transcript_path')"
CWD="$(jqget '.cwd')"
STOP_REASON="$(jqget '.reason')"

# ─── Scan transcript ONLY for Skill tool invocations ──────────
# We grep for the literal pattern '"name":"Skill"..."skill":"X"' and
# nothing else. We do NOT load the transcript into memory or read
# message content. This is auditable: open this script and verify.
#
# F4 fix: explicit if/then/fi avoids the `[ A ] || [ B ] && exit`
# precedence trap where short-circuit-and binds tighter than ||.
if [ -z "$TRANSCRIPT" ] || [ ! -f "$TRANSCRIPT" ]; then
  exit 0
fi

# Find all skill invocations in this session
INVOKED_SKILLS=$(grep -o '"name":"Skill"[^}]*"skill":"[^"]*"' "$TRANSCRIPT" 2>/dev/null \
  | grep -o '"skill":"[^"]*"' \
  | cut -d'"' -f4 \
  | sort -u || true)

# If TARGET_SKILL was not invoked in this session, exit silently.
# This is the "skill filtering" responsibility — a hook for tdoc never
# fires for office-hours sessions.
echo "$INVOKED_SKILLS" | grep -qx "$TARGET_SKILL" || exit 0

# ─── Outcome heuristic — NO transcript text captured ────────
# Outcome heuristic — structural, not regex-on-text.
#
# Bug history (dogfood, June 2026): the previous heuristic was
#   tail -5 | grep 'interrupted|abort'  → OUTCOME=abandoned
#   tail -5 | grep '"is_error":true'    → OUTCOME=error
# That fired on:
#   - Any conversation discussing "abandoned"/"interrupted" (e.g. THIS
#     codebase's own README, debugging logs, error-handling code)
#   - Every Bash tool_result with a non-zero exit (`is_error:true`),
#     even when the session itself succeeded
# Result: 40% false-abandon rate, ~half the recorded errors were spurious.
#
# Correct signal lives in structured fields, not free text:
#   - assistant message `stop_reason: "interrupted"` → user pressed ESC
#   - tool_result content like "Tool use was rejected by the user"
#     OR the literal "[Request interrupted by user]" → explicit deny
#
# F3 privacy fix still holds: we only emit a low-cardinality class tag,
# never the raw message text.
OUTCOME="success"
ERROR_CLASS=""

# Read just the tail (last 20 JSONL lines covers the final exchange
# without scanning multi-MB transcripts).
LAST_TAIL="$(tail -20 "$TRANSCRIPT" 2>/dev/null || true)"

if [ -n "$LAST_TAIL" ] && command -v jq >/dev/null 2>&1; then
  # 1) Did the FINAL assistant turn end with stop_reason=interrupted?
  #    That's Claude Code's signal for "user pressed ESC mid-stream".
  LAST_STOP_REASON=$(printf '%s\n' "$LAST_TAIL" \
    | jq -rs 'map(select(.type == "assistant")) | last
              | .message.stop_reason // empty' 2>/dev/null)
  # 2) Did the FINAL user turn contain a literal "[Request interrupted by user]"
  #    marker? That's what Claude Code writes when the user denies a tool
  #    call or cancels in the middle of a tool execution.
  LAST_USER_HAS_INTERRUPT=$(printf '%s\n' "$LAST_TAIL" \
    | jq -rs 'map(select(.type == "user")) | last
              | .message.content
              | tostring
              | test("Request interrupted by user|Tool use was rejected by user")' 2>/dev/null)

  if [ "$LAST_STOP_REASON" = "interrupted" ] || [ "$LAST_USER_HAS_INTERRUPT" = "true" ]; then
    OUTCOME="abandoned"
  fi
fi
# No fallback `grep` branch — false positives are worse than false negatives
# here. If jq is missing the user's environment is unusual; we'd rather
# undercount abandons than mislabel half the corpus.

# ─── Duration computation ───────────────────────────────────
# Two strategies in priority order:
#   1. SKILL.md preamble sentinel (if it ran) — most accurate
#   2. Transcript timestamps — first→last Skill-tool call for THIS skill.
#      Approximates "time spent using the skill" even when preamble was
#      skipped (which is the common case for proactive skills).
DURATION_ARG=""
DUR=""

# Strategy 1: sentinel file from preamble
# CODEX-C2 fix: SESSION_ID comes from a JSON payload on stdin — treat as
# untrusted. Sanitize for filesystem use (raw value of "../../x" would
# escape the state dir).
STATE_DIR="${SKILL_TELEMETRY_DIR:-$HOME/.${TARGET_SKILL}}"
SESSION_ID_SAFE="$(printf '%s' "$SESSION_ID" | tr -cd 'A-Za-z0-9_-' | cut -c1-64)"
START_FILE="$STATE_DIR/sentinels/$SESSION_ID_SAFE"
if [ -f "$START_FILE" ]; then
  START_EPOCH="$(cat "$START_FILE" 2>/dev/null || echo "")"
  if [ -n "$START_EPOCH" ]; then
    DUR=$(( $(date +%s) - START_EPOCH ))
    [ "$DUR" -lt 0 ] && DUR=""
    rm -f "$START_FILE" 2>/dev/null || true
  fi
fi

# Strategy 2: transcript timestamps (fallback when no sentinel).
# Compute duration as: first Skill:TARGET_SKILL call → last message in
# this 24h window. The window guard handles long-lived sessions where
# the same transcript file persists for days (Claude Code reuses
# transcripts across resumes).
if [ -z "$DUR" ]; then
  NOW_EPOCH=$(date +%s)
  CUTOFF_EPOCH=$(( NOW_EPOCH - 86400 ))  # 24h ago

  # Most recent skill-tool-call timestamp. F11 fix: was `head -1` which
  # picked the FIRST occurrence ever — meaning if today's session reused
  # a transcript from a prior day's invocation of the same skill,
  # duration was over-reported. Using `tail -1` picks today's call.
  SKILL_TS=$(grep '"skill":"'"$TARGET_SKILL"'"' "$TRANSCRIPT" 2>/dev/null \
    | grep -oE '"timestamp":"[^"]+"' \
    | cut -d'"' -f4 \
    | tail -1)

  # Helper: parse an ISO-8601 timestamp into epoch. Tries GNU date -d
  # first (handles fractional + Z natively), then BSD date with explicit
  # format on a stripped-down value. Mirrors telemetry-sync for parity.
  ts_to_epoch() {
    local _ts="$1"
    TZ=UTC date -d "$_ts" "+%s" 2>/dev/null \
      || TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%SZ" "${_ts%%.*}Z" "+%s" 2>/dev/null \
      || TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "${_ts%%.*}" "+%s" 2>/dev/null \
      || echo ""
  }

  if [ -n "$SKILL_TS" ]; then
    SKILL_EPOCH=$(ts_to_epoch "$SKILL_TS")
    # Only count it if it's within the last 24h (current session,
    # not an old reused transcript)
    if [ -n "$SKILL_EPOCH" ] && [ "$SKILL_EPOCH" -ge "$CUTOFF_EPOCH" ]; then
      # Find the LAST message timestamp in the whole transcript
      LAST_TS=$(grep -oE '"timestamp":"[^"]+"' "$TRANSCRIPT" 2>/dev/null \
        | cut -d'"' -f4 \
        | tail -1)
      if [ -n "$LAST_TS" ]; then
        LAST_EPOCH=$(ts_to_epoch "$LAST_TS")
        if [ -n "$LAST_EPOCH" ]; then
          DUR=$(( LAST_EPOCH - SKILL_EPOCH ))
          [ "$DUR" -lt 0 ] && DUR=""
          # Cap at 24h — single sessions don't run that long
          [ -n "$DUR" ] && [ "$DUR" -gt 86400 ] && DUR=""
        fi
      fi
    fi
  fi
fi

[ -n "$DUR" ] && DURATION_ARG="--duration $DUR"

# ─── Hand off to telemetry-log ──
# Use event_type=skill_run, source=hook so the author can distinguish
# hook-captured events from SKILL.md self-reported ones in dashboards.
"$TEL_BIN" \
  --skill "$TARGET_SKILL" \
  --event-type "skill_run" \
  --outcome "$OUTCOME" \
  --session-id "${SESSION_ID:-hook-$(date +%s)}" \
  --step "hook-captured" \
  --source hook \
  ${DURATION_ARG} \
  ${ERROR_CLASS:+--error-class "$ERROR_CLASS"} \
  2>/dev/null || true

exit 0
